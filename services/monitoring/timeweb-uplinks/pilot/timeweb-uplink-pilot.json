{
  "uid": "timeweb-uplink-pilot",
  "title": "TimeWeb Uplinks - Pilot",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "vpn",
    "pilot",
    "timeweb"
  ],
  "refresh": "10s",
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "TimeWeb uplinks / PILOT",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "NO DATA"
        },
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "**Измерения: 120 секунд.** TimeWeb → WireGuard → Cenuta / Fornex → HTTPS. Пилот: RTNL + снимки состояния, без полной защиты от WG/firewall ABA. **UNKNOWN / NO DATA не означают исправную связь.** История Grafana накапливается, пока Mac подключён; автономная история хранится на TimeWeb."
      }
    },
    {
      "id": 2,
      "title": "Cenuta",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "NO DATA",
          "color": {
            "mode": "fixed",
            "fixedColor": "gray"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "UNKNOWN",
                  "color": "gray"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                },
                "2": {
                  "text": "DEGRADED",
                  "color": "yellow"
                },
                "3": {
                  "text": "DOWN",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "(vpn_uplink_state{upstream=\"cenuta\"}) and on(job,instance) (up{job=\"timeweb-uplink-pilot\"} == 1)",
          "refId": "A",
          "legendFormat": "{{upstream}}",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      }
    },
