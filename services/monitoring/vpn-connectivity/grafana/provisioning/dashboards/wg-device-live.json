{
  "uid": "wg-device-live",
  "title": "VPN: устройство и активный тоннель",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "15s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "device",
        "label": "Устройство",
        "type": "custom",
        "query": "macbook,iphone,macmini,ipad-pro-sergey,ipad-97-sergey,macbook-m3-sveta,iphone-16-sveta,ipad-97-sveta,digitalrazor,samsung-pad,win-orekhovo,apple-tv-1,apple-tv-fethiye,apple-tv-4k,apple-tv-orekhovo,avg-redmi,anv-samsung,honor-lana-turk,mariia-mac,mikrotik-n11,igor-unassigned",
        "current": {
          "selected": true,
          "text": "macbook",
          "value": "macbook"
        },
        "hide": 0,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "links": [
    {
      "type": "link",
      "title": "К устройствам",
      "url": "/d/timeweb-uplink-pilot/timeweb-uplinks-pilot"
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Наблюдаемый тоннель",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "vpn_device_active_tunnel{device=\"$device\"} or on() label_replace(vector(0), \"tunnel\", \"Нет активного наблюдаемого тоннеля\", \"__name__\", \".*\")",
          "instant": true,
          "legendFormat": "{{tunnel}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "—",
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "name"
      }
    },
    {
      "id": 2,
      "title": "Состояние устройства",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
