      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "—",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Нет свежих наблюдений",
                  "color": "gray"
                },
                "1": {
                  "text": "Активен",
                  "color": "green"
                },
                "2": {
                  "text": "Нет активного наблюдаемого тоннеля",
                  "color": "yellow"
                },
                "3": {
                  "text": "Недавний Xray access (<90 с)",
                  "color": "yellow"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
