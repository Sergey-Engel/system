[Unit]
Description=WSS fallback transport for TimeWeb to Fornex WireGuard exit
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=simple
ExecStart=/usr/local/lib/wstunnel/wstunnel server --tls-certificate /etc/wstunnel/fornex-wg-fallback/server.crt --tls-private-key /etc/wstunnel/fornex-wg-fallback/server.key --tls-client-ca-certs /etc/wstunnel/fornex-wg-fallback/ca.crt --restrict-to 127.0.0.1:51821 wss://0.0.0.0:8443
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
